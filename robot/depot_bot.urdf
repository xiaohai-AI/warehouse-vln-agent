      <origin rpy="-2.35619 -0.69813 0" xyz="0.04338 0 0.03640"/>
      <geometry>
        <cylinder length="0.07071" radius="0.01937"/>
      </geometry>
      <material name="amr_grey_lt"/>
    </visual>
    <visual name="roller_r2">
      <origin rpy="-2.35619 -1.39626 0" xyz="0.00983 0 0.05577"/>
      <geometry>
        <cylinder length="0.07071" radius="0.01937"/>
      </geometry>
      <material name="amr_grey_lt"/>
    </visual>
    <visual name="roller_r3">
      <origin rpy="0.78540 -1.04720 3.14159" xyz="-0.02832 0 0.04904"/>
      <geometry>
        <cylinder length="0.07071" radius="0.01937"/>
      </geometry>
      <material name="amr_grey_lt"/>
    </visual>
    <visual name="roller_r4">
      <origin rpy="0.78540 -0.34907 3.14159" xyz="-0.05322 0 0.01937"/>
      <geometry>
        <cylinder length="0.07071" radius="0.01937"/>
      </geometry>
      <material name="amr_grey_lt"/>
    </visual>
    <visual name="roller_r5">
      <origin rpy="0.78540 0.34907 3.14159" xyz="-0.05322 0 -0.01937"/>
      <geometry>
        <cylinder length="0.07071" radius="0.01937"/>
      </geometry>
      <material name="amr_grey_lt"/>
    </visual>
    <visual name="roller_r6">
      <origin rpy="0.78540 1.04720 3.14159" xyz="-0.02832 0 -0.04904"/>
      <geometry>
        <cylinder length="0.07071" radius="0.01937"/>
