      <visualize>false</visualize>
      <topic>lidar3d</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.43633</min_angle>
            <max_angle>0.26180</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.30</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- IMU：200 Hz，含噪声 + 零偏随机游走 -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.134"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <update_rate>200</update_rate>
      <always_on>true</always_on>
      <topic>imu</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0009</stddev>
              <dynamic_bias_stddev>0.00004</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>200</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0009</stddev>
              <dynamic_bias_stddev>0.00004</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>200</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0009</stddev>
              <dynamic_bias_stddev>0.00004</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>200</dynamic_bias_correlation_time>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.012</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.012</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.012</stddev>
            </noise>
          </z>
        </linear_acceleration>
