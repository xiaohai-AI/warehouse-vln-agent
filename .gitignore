# ---- 生成物（可由 `make world` / `make robot` 复现，不入库）
.venv/
__pycache__/
*.pyc
.pytest_cache/
world/warehouse.sdf
world/layout.json
world/textures/
world/fixtures/
maps/*.pgm
maps/*.db

# ---- 原始传感器数据 / 建图中断产物（SPEC「不交付」）
data/
bags/
results/raw/
results/**/*.npz
results/**/*.png
results/depth_dumps/
results/*_frames/
logs/
*.log

# ---- 评测产物：小体积证据入库，逐次运行的大文件忽略
transitions/*.jsonl.tmp
!results/*.json
!results/*.csv
# 采集运行日志：每次覆盖，记的是"这一轮跑到哪"，不作为证据（必须放在 !results/*.json 之后）
results/seg2_capture_manifest.json
ground_truth/poses.csv

# ---- LangGraph checkpoint / demo sqlite
state/

# ---- 原始录屏（体积大，压成 mp4/gif 后再入库）
docs/media/*.webm
docs/media/*.mkv
docs/media/*.mov
